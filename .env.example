# Copy to .env and fill in. .env is gitignored and its values are never written
# to logs/signnow-audit.log.

# Sandbox: https://api-eval.signnow.com   Production: https://api.signnow.com
SIGNNOW_BASE_URL=https://api-eval.signnow.com

# --- Option 1 (use this for a Google sign-in account) -------------------------
# An API key from the SignNow developer dashboard. It is used directly as the
# bearer token, so no username or password is needed. Keys are per-environment:
# a sandbox key will not work against production, and vice versa.
SIGNNOW_ACCESS_TOKEN=

# --- Option 2 (only if the account has a SignNow-native password) -------------
# Leave these blank when SIGNNOW_ACCESS_TOKEN is set.
SIGNNOW_CLIENT_ID=
SIGNNOW_CLIENT_SECRET=
SIGNNOW_USERNAME=
SIGNNOW_PASSWORD=
